<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_deep_ambient"
    android:orientation="vertical">

    <!-- ================= CONTENEDOR PRINCIPAL ================= -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= PANTALLA 1: COMPARADOR (DISEÑO PREMIUM) ================= -->
        <LinearLayout
            android:id="@+id/layoutSearchTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- HEADER SUPERIOR: AVATAR / GREETING / UBICACIÓN Y TASA BCV -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="14dp"
                android:paddingBottom="8dp">

                <!-- Avatar circular con icono de compras -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_filter_squircle">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_shopping_cart"
                        app:tint="@color/vibrant_purple" />
                </FrameLayout>

                <!-- Título principal -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Resuelve Precios"
                    android:textColor="@color/text_light_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- Ubicación y Tasa Oficial BCV con botón táctil -->
                <LinearLayout
                    android:id="@+id/btnRefreshBcv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_filter_squircle"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_location"
                        app:tint="@color/vibrant_gold" />

                    <TextView
                        android:id="@+id/tvBcvHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/bcv_loading"
                        android:textColor="@color/text_light_secondary"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="Refrescar"
                        android:src="@drawable/ic_refresh"
                        app:tint="@color/vibrant_purple" />

                </LinearLayout>

            </LinearLayout>

            <!-- BARRA DE BÚSQUEDA Y BOTÓN DE FILTRO (Estilo de referencia) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <!-- Botón de Filtros / Opciones (Squircle con ic_tune) -->
                <FrameLayout
                    android:id="@+id/btnFilters"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_filter_squircle"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Filtros"
                        android:src="@drawable/ic_tune"
                        app:tint="@color/text_light_primary" />
                </FrameLayout>

                <!-- Campo de búsqueda en cápsula con fondo deep y borde fino -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_capsule"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_search"
                        app:tint="@color/text_light_dim" />

                    <EditText
                        android:id="@+id/etSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Buscar producto o marca..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColor="@color/text_light_primary"
                        android:textColorHint="@color/text_light_dim"
                        android:textSize="13sp" />

                    <ProgressBar
                        android:id="@+id/pbLoading"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginEnd="6dp"
                        android:indeterminateTint="@color/vibrant_purple"
                        android:visibility="gone" />

                    <FrameLayout
                        android:id="@+id/btnClearSearch"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:contentDescription="Limpiar"
                            android:src="@drawable/ic_clear"
                            app:tint="@color/text_light_secondary" />
                    </FrameLayout>

                    <!-- Botón de Escáner de Código de Barras -->
                    <FrameLayout
                        android:id="@+id/btnBarcodeScan"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="Escanear código de barra"
                            android:src="@drawable/ic_barcode_scanner"
                            app:tint="@color/vibrant_gold" />
                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- PANEL DE SUGERENCIAS DE AUTOCOMPLETADO PREDICTIVO -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSearchSuggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_ticket_card"
                android:elevation="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone" />

            <!-- SUBTÍTULO "CATEGORÍAS" Y CARRUSEL DE SQUIRCLES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="6dp"
                android:text="CATEGORÍAS POPULARES"
                android:textColor="@color/text_light_dim"
                android:textSize="11sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp" />

            <!-- ================= SHEET BLANCO INFERIOR CURVO (28dp) ================= -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_curved_sheet"
                android:elevation="12dp"
                android:orientation="vertical">

                <!-- Handle bar superior sutil -->
                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_sheet_handle" />

                <!-- Encabezado de la lista: "MEJORES OPCIONES" (Estilo 'BEST OPTIONS') -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/tvSheetHeaderTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CATÁLOGO UNIFICADO"
                        android:textColor="@color/text_dark_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvResultsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_dark_secondary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>

                <!-- Contenedor de contenido: RecyclerView, Idle Home, Skeleton y Empty -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <!-- Estado Inicial / Home Dinámico -->
                    <include
                        android:id="@+id/layoutIdleView"
                        layout="@layout/layout_catalog_idle_state" />

                    <!-- Skeleton Shimmer de Carga Rápida -->
                    <LinearLayout
                        android:id="@+id/layoutSkeleton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="14dp"
                        android:visibility="gone">

                        <include layout="@layout/item_skeleton_card" />
                        <include layout="@layout/item_skeleton_card" />
                        <include layout="@layout/item_skeleton_card" />

                    </LinearLayout>

                    <!-- Estado Vacío (Sin Resultados) -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyResults"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search"
                            app:tint="@color/text_dark_secondary" />

                        <TextView
                            android:id="@+id/tvEmptyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="No se encontraron productos"
                            android:textColor="@color/text_dark_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEmptySubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:text="Intenta buscar por marca (ej: Yoka, Mary) o producto general (ej: Arroz, Harina)."
                            android:textColor="@color/text_dark_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvComparisons"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingStart="14dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="12dp"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- ================= PANTALLA 2: MI LISTA DE COMPRAS ================= -->
        <LinearLayout
            android:id="@+id/layoutShoppingListTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Encabezado de la Cesta -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mi Cesta de Compras"
                    android:textColor="@color/text_light_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnShareShoppingList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_btn_whatsapp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="COMPARTIR"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnClearShoppingList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_filter_squircle"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="VACIAR"
                    android:textColor="@color/delete_red"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Sheet blanco con la Tarjeta Resumen y la lista de artículos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_curved_sheet"
                android:elevation="12dp"
                android:orientation="vertical">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_sheet_handle" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:id="@+id/containerShoppingListContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <!-- Resumen Comparativo de Cesta Total -->
                        <include
                            android:id="@+id/basketSummaryView"
                            layout="@layout/view_basket_summary" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvShoppingItems"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:clipToPadding="false"
                            android:paddingBottom="12dp" />

                    </LinearLayout>

                    <!-- Estado Vacío -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyShoppingList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_marginBottom="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_shopping_cart"
                            app:tint="@color/text_dark_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/shopping_list_empty_title"
                            android:textColor="@color/text_dark_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/shopping_list_empty_desc"
                            android:textColor="@color/text_dark_secondary"
                            android:textSize="13sp" />

                    </LinearLayout>

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <!-- ================= BARRA DE NAVEGACIÓN INFERIOR MODERNA ================= -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/deep_space_dark"
        android:elevation="12dp"
        app:itemIconTint="@color/bottom_nav_colors"
        app:itemTextColor="@color/bottom_nav_colors"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
